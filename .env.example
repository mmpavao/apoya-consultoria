# ═══════════════════════════════════════════════════════════════════════════════
# APOYA Gestão — variáveis de ambiente
#
# Copie para .env.local (dev) ou configure como secrets no Cloudflare Worker.
# NUNCA commite .env.local — está no .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (obrigatório) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://ajaqbdsalxfgrwpjbtbn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=           # anon key (pública — injetada no build Vite)
SUPABASE_URL=https://ajaqbdsalxfgrwpjbtbn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # SECRET — somente server-side / Edge Functions

# ── Cloudflare Worker (runtime secrets) ───────────────────────────────────────
APOYA_SERVICE_TOKEN=                     # Token interno gestão ↔ MCP / webhooks
APOYA_INTERNAL_SECRET=                   # Chamadas internas entre workers
MCP_URL=                                 # Opcional — default: apoya-mcp*.talkzzbot.workers.dev
WORKER_ENV=staging                       # staging | production (define MCP default)

# ── Pagamentos / Cobrança ─────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── NFS-e ─────────────────────────────────────────────────────────────────────
FOCUSNFE_API_TOKEN=
NFSE_EMISSAO_BLOQUEADA=false             # true = bloqueia emissão (Focus congelado)

# ── WhatsApp (Evolution API) ──────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ── Open Finance (Pluggy) ─────────────────────────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# ── CI/CD (GitHub Actions secrets — não usar localmente) ───────────────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# SUPABASE_ACCESS_TOKEN=                 # Supabase CLI — deploy Edge Functions

# ── Build (injetadas no CI) ───────────────────────────────────────────────────
# VITE_APP_VERSION=
# VITE_APP_BUILD_TS=
